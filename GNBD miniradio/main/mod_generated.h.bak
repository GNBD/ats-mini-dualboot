static const char *MR_TAG = "mod";

/* minimum interval between two firings of the same rule */
#define MR_COOLDOWN_MS 10000u

/* rule 1: ui_menu */
static bool mr_r0_cond(void)
{
    return (s_radio_ok && !s_seeking && !band_is_ssb(s_ui.mode));
}
static void mr_r0_fire(uint32_t now)
{
    (void)now;
    if (!seek_start(true)) {
        ESP_LOGW(MR_TAG, "seek rejected");
    }
    ESP_LOGI(MR_TAG, "rule 1 fired rssi=%d snr=%d",
             s_ui.have_rsq ? (int)s_ui.rsq.rssi : -1,
             s_ui.have_rsq ? (int)s_ui.rsq.snr : -1);
}

bool mod_user_menu_event(int element)
{
    bool handled = false;
    uint32_t now = now_ms();
    (void)now;
    if (element == RM_MOD_A) {
        handled = true;
        if (mr_r0_cond()) mr_r0_fire(now);
    }
    return handled;
}

void mod_user_init(void)
{
    ESP_LOGI(MR_TAG, "enabled project=%s version=%s rules=%d",
             MOD_PROJECT_NAME, MOD_PROJECT_VERSION, 1);
}

