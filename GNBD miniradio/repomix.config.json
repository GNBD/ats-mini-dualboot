{
  "$schema": "https://json.schemastore.org/repomix",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "MiniRadio - ESP32 기반 라디오 프로젝트 전체 소스코드 번들입니다.",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "topFilesLen": 10,
    "includeEmptyDirectories": false
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "releasev1/**",
      "docs/**",
      "components/lovyan_gfx/**",
      "managed_components/**",
      "build/**",
      "*.txt"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
